{
  "name": "@reactive-forge/eslint-config",
  "version": "0.1.0",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
