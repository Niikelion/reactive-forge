{
  "name": "@reactive-forge/codegen",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "bin": {
    "forge": "./dist/bin.mjs"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint \"**/*.ts\"",
    "build": "tsdown && attw --pack ."
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@reactive-forge/schema": "1.0.0",
    "@types/prompts": "^2.4.9",
    "commander": "^13.1.0",
    "dedent": "^1.5.3",
    "kleur": "^4.1.5",
    "load-config-ts": "^0.1.0",
    "prompts": "^2.4.2",
    "ts-morph": ">=25.0.1",
    "ts-node": ">=10.9.2",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.3",
    "@gamedev-sensei/ts-config": "^2.0.1",
    "@gamedev-sensei/tsdown-config": "^2.0.1",
    "@reactive-forge/eslint-config": "0.1.0",
    "@types/node": ">=22.13.4",
    "eslint": "^9.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
